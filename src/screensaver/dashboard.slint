import { DigitalClock } from "clock.slint";

component StatusTile inherits Rectangle {
    in property <string> name;
    in property <string> detail;
    in property <string> symbol;
    in property <color> accent;

    border-radius: clamp(self.height * 0.24, 16px, 28px);
    border-width: 1px;
    border-color: #cedee52c;
    background: @linear-gradient(145deg, #e9f6fa16 0%, #a5c4ce0f 100%);
    clip: true;

    icon := Path {
        x: clamp(root.width * 0.10, 13px, 40px);
        y: (parent.height - self.height) / 2;
        width: clamp(root.height * 0.34, 21px, 40px);
        height: self.width;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.accent;
        stroke-width: 1.8px;
        commands: root.symbol;
        accessible-role: none;
    }

    VerticalLayout {
        x: icon.x + icon.width + clamp(root.width * 0.058, 10px, 24px);
        width: max(0px, parent.width - self.x - 12px);
        alignment: center;
        spacing: clamp(root.height * 0.05, 2px, 6px);

        Text {
            text: root.name;
            font-family: "Segoe UI Variable Display";
            color: #fafaf8;
            font-size: clamp(root.height * 0.21, 14px, 27px);
            font-weight: 650;
            overflow: elide;
        }

        Text {
            text: root.detail;
            font-family: "Segoe UI Variable Display";
            color: #ccd6da;
            font-size: clamp(root.height * 0.175, 12px, 23px);
            overflow: elide;
        }
    }
}

export component SaverDashboard inherits Rectangle {
    in property <image> orb;
    in property <string> clock;
    in property <string> period;
    in property <string> date;
    in property <string> timer;
    in property <string> media;
    in property <float> drift;
    in property <color> tint;
    in property <bool> show-clock: true;
    in property <bool> show-date: true;
    in property <bool> show-orb: true;
    in property <bool> show-timer: true;
    in property <bool> show-media: true;

    property <bool> compact: self.width < 840px || self.height > self.width;
    property <bool> has-heading: root.show-clock || root.show-date;
    property <bool> has-status: root.show-timer || root.show-media;
    property <bool> has-left: root.has-heading || root.has-status;
    property <bool> split: !root.compact && root.show-orb && root.has-left;
    property <length> content-width: min(1710px, self.width * (root.compact ? 0.88 : 0.83));
    property <length> content-x: (self.width - root.content-width) / 2;
    property <length> info-width: root.split ? root.content-width * 0.535 : min(820px, root.content-width);
    property <length> info-x: root.split ? root.content-x : (self.width - root.info-width) / 2;
    property <length> hero-width: root.split ? root.content-width - root.info-width : root.content-width;
    property <length> hero-center: root.split ? root.content-x + root.info-width + root.hero-width / 2 : self.width / 2;
    property <length> digit-size: clamp(min(root.info-width * 0.28, self.height * (root.compact ? 0.155 : 0.23)), 48px, 250px);
    property <length> date-size: clamp(root.info-width * 0.042, 16px, 38px);
    property <length> heading-height: (root.show-clock ? root.digit-size * 1.19 : 0px) + (root.show-date ? root.date-size * 1.45 : 0px);
    property <length> tile-gap: clamp(root.info-width * 0.032, 10px, 28px);
    property <length> tile-height: clamp(min(root.info-width * 0.155, self.height * 0.125), 64px, 130px);
    property <length> tile-width: root.show-timer && root.show-media ? (root.info-width - root.tile-gap) / 2 : min(root.info-width, 470px);
    property <length> status-x: root.info-x + (root.show-timer && root.show-media ? 0px : (root.info-width - root.tile-width) / 2);
    property <length> section-gap: root.has-heading && root.has-status ? clamp(self.height * 0.035, 14px, 38px) : 0px;
    property <length> status-height: root.has-status ? root.tile-height : 0px;
    property <length> info-height: root.heading-height + root.section-gap + root.status-height;
    property <length> compact-gap: root.compact && root.show-orb && root.has-left ? clamp(self.height * 0.022, 10px, 22px) : 0px;
    property <length> hero-height: root.show-orb ? (root.compact ? min(root.hero-width * 0.75, self.height * 0.42, 480px) : min(root.hero-width, self.height * 0.76, 650px)) : 0px;
    property <length> info-y: (self.height - root.info-height - (root.compact ? root.hero-height + root.compact-gap : 0px)) / 2;
    property <length> hero-y: root.compact ? root.info-y + root.heading-height + root.compact-gap : (self.height - root.hero-height) / 2;
    property <length> hero-art-size: root.hero-height * (root.compact ? 1.07 : 1.02);
    property <length> hero-art-x: root.hero-center - root.hero-art-size / 2 + root.drift * 6px;
    property <length> hero-art-y: root.hero-y - root.hero-height * (root.compact ? 0.085 : 0.034) + root.drift * 5px;
    property <length> tile-y: root.info-y + root.heading-height + root.section-gap + (root.compact ? root.hero-height + root.compact-gap : 0px);
    property <color> glow-color: #228f85.mix(root.tint, 0.84);

    clip: true;
    background: @linear-gradient(118deg, #090b10 0%, #0d141a 55%, #080e13 100%);

    if root.show-orb: Rectangle {
        x: root.hero-art-x + (root.hero-art-size - self.width) / 2;
        y: root.hero-art-y + (root.hero-art-size - self.height) / 2;
        width: root.hero-art-size * 2.2;
        height: self.width;
        background: @radial-gradient(circle, root.glow-color.with-alpha(0.9) 0%, root.glow-color.with-alpha(0.43) 24%, root.glow-color.with-alpha(0.14) 48%, root.glow-color.with-alpha(0.0) 73%);
        accessible-role: none;
    }

    if root.has-heading: DigitalClock {
        x: root.info-x;
        y: root.info-y;
        width: root.info-width;
        height: root.heading-height;
        digits: root.show-clock ? root.clock : "";
        period: root.period;
        date: root.show-date ? root.date : "";
        digit-size: root.digit-size;
        digit-weight: 560;
        date-size: root.date-size;
        ink: #faf7f0;
        secondary: #f0efec;
    }

    if root.show-orb: Image {
        x: root.hero-art-x;
        y: root.hero-art-y;
        width: root.hero-art-size;
        height: self.width;
        source: root.orb;
        image-fit: contain;
        accessible-role: image;
        accessible-label: "Amica orb";
    }

    if root.show-timer: StatusTile {
        x: root.status-x;
        y: root.tile-y;
        width: root.tile-width;
        height: root.tile-height;
        name: "Timer";
        detail: root.timer == "" ? "No active timer" : root.timer;
        accent: #ffc46e;
        symbol: "M 10 3 H 14 M 12 3 V 6 M 18 8 L 20 6 M 12 10 V 14 L 15 16 M 12 6 A 7.5 7.5 0 1 1 11.99 6 Z";
    }

    if root.show-media: StatusTile {
        x: root.status-x + (root.show-timer ? root.tile-width + root.tile-gap : 0px);
        y: root.tile-y;
        width: root.tile-width;
        height: root.tile-height;
        name: "Now Playing";
        detail: root.media;
        accent: #69ebd8;
        symbol: "M 9 17 V 7 L 19 5 V 15 M 9 17 C 9 19 5 20 4 18.5 C 3 16.5 8 15 9 17 M 19 15 C 19 17 15 18 14 16.5 C 13 14.5 18 13 19 15";
    }
}
