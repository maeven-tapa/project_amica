import { Button, ComboBox, LineEdit, ListView, TextEdit } from "std-widgets.slint";

export struct RoutineRow { name: string, shortcut: string }

export component RoutinePanel inherits Rectangle {
    in property <[RoutineRow]> rows;
    in-out property <string> name;
    in-out property <string> script;
    in property <string> result;
    in property <bool> running;
    callback edit(string, string, string);
    callback stop;
    background: #f7fbfb;
    border-radius: 22px;
    border-color: #dfebed;
    border-width: 1px;

    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        Text { text: "Routines"; color: #173944; font-size: 21px; font-weight: 650; }
        ListView {
            height: min(116px, root.rows.length * 35px);
            for routine in root.rows: HorizontalLayout {
                height: 34px;
                Button {
                    text: routine.shortcut == "" ? routine.name : routine.name + " · " + routine.shortcut;
                    clicked => { root.edit("select", routine.name, ""); }
                }
            }
        }
        LineEdit {
            text <=> root.name;
            placeholder-text: "Routine name";
            accessible-label: "Routine name";
        }
        Text {
            text: "One step per line. Try Open Notepad, Timer 1500 Focus, Wait 5, Folder Documents, Pause media, or Show tasks.";
            color: #536b74;
            wrap: word-wrap;
            font-size: 11px;
        }
        TextEdit {
            text <=> root.script;
            min-height: 72px;
            vertical-stretch: 1;
            accessible-label: "Ordered routine steps";
        }
        HorizontalLayout {
            spacing: 5px;
            Button { text: "Save"; enabled: !root.running; clicked => { root.edit("save", root.name, root.script); } }
            Button { text: root.running ? "Stop" : "Preview & run"; clicked => { if root.running { root.stop(); } else { root.edit("run", root.name, ""); } } }
            Button { text: "Last run"; clicked => { root.edit("last", root.name, ""); } }
        }
        ComboBox {
            model: ["None", "F2", "F3", "F4", "F5", "F6", "F7", "F8"];
            accessible-label: "Assign routine shortcut";
            enabled: !root.running && root.name != "";
            selected(value) => { root.edit("shortcut", root.name, value); }
        }
        if root.result != "": Text {
            height: min(83px, self.preferred-height);
            text: root.result;
            color: #674694;
            wrap: word-wrap;
            overflow: elide;
        }
    }
}
