import { Button } from "std-widgets.slint";

export component GridOverlay inherits Window {
    title: "Amica Mouse Grid";
    no-frame: true;
    always-on-top: true;
    background: #30245465;
    in property <int> columns: 3;
    in property <int> rows: 3;
    callback select-cell(int);
    callback cancel;

    forward-focus: shortcuts;
    init => { shortcuts.focus(); }

    shortcuts := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); return accept; }
            return reject;
        }
        for row in root.rows: Rectangle {
            y: row * root.height / root.rows;
            width: root.width;
            height: root.height / root.rows;
            for column in root.columns: Rectangle {
                x: column * parent.width / root.columns;
                width: parent.width / root.columns;
                height: parent.height;
                border-width: 1px;
                border-color: #d7c2ff;
                Button {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: 1 + row * root.columns + column;
                    clicked => { root.select-cell(1 + row * root.columns + column); }
                }
                TouchArea {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    clicked => { root.select-cell(1 + row * root.columns + column); }
                }
            }
        }
    }
}

export component PointerMarker inherits Window {
    title: "Amica Pointer Marker";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    in property <color> ring: #eeeeff;
    in property <string> shape;
    if root.shape != "crosshairs" && root.shape != "dashed circle": Rectangle {
        width: parent.width - 8px;
        height: parent.height - 8px;
        border-radius: root.shape == "large square" || root.shape == "small square" ? 0px : self.width / 2;
        border-width: 4px;
        border-color: root.ring;
        accessible-role: none;
    }
    if root.shape == "crosshairs": Rectangle { width: parent.width - 8px; height: 3px; background: root.ring; }
    if root.shape == "crosshairs": Rectangle { height: parent.height - 8px; width: 3px; background: root.ring; }
    for index in (root.shape == "dashed circle" ? 12 : 0): Rectangle {
        width: 5px;
        height: 5px;
        x: parent.width / 2 + sin(index * 30deg) * (parent.width / 2 - 6px) - 2px;
        y: parent.height / 2 + cos(index * 30deg) * (parent.height / 2 - 6px) - 2px;
        background: root.ring;
    }
}
